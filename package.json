{
  "name": "ialmobil-admin-windows",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev:vite": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "security-audit": "npm audit --production",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev:electron": "concurrently -k \"npm run dev:vite\" \"npm run electron\"",
    "dev": "npm run dev:electron",
    "make": "npm run build && electron-builder --win --x64",
    "make:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "detectincognitojs": "^1.9.0",
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "terser": "^5.49.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ialmobil.admin",
    "productName": "IALMobil Admin",
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "zip"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
